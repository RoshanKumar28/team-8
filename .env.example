# Vercel AI Gateway (OpenAI-compatible). Get a key at vercel.com/ai-gateway
LLM_API_KEY=
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_MODEL=zai/glm-5.3-flash

# 1 = scripted coach replies (no API calls, demo-safe). Remove to go live.
MOCK_AI=1

# Optional — WhatsApp nudges via Twilio sandbox. App degrades gracefully without.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=
